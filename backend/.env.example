# ===== 大模型配置 =====
# 使用阿里云 DashScope（通义千问），它提供 OpenAI 兼容接口
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen3.8-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# ===== RAG / 向量库配置 =====
CHROMA_DB_DIR=db/chroma_db
CHROMA_COLLECTION_NAME=travel_guides
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank
EMBEDDING_BATCH_SIZE=10

# ===== Redis / 缓存配置 =====
# 需要先启动 Redis；未安装时设为 false 会自动降级，不影响运行
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=trip_planner
REDIS_DEFAULT_TTL_SECONDS=1800
REDIS_WEATHER_TTL_SECONDS=1800
REDIS_MAP_TTL_SECONDS=86400
REDIS_RAG_TTL_SECONDS=21600
REDIS_RERANK_TTL_SECONDS=21600

# ===== 高德地图配置 =====
# 需要在高德开放平台申请 Key；未配置时设为 false 不影响核心功能
AMAP_API_KEY=your_amap_web_service_key_here
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_DEFAULT_CITY=
AMAP_TIMEOUT_SECONDS=20
ENABLE_AMAP_ENRICHMENT=false

# ===== RAG 模型级优化配置（阶段10）=====
# LLM 查询改写：开启后用通义千问理解意图，关闭用规则版
USE_LLM_REWRITE=false
# LLM 重排序：开启后用 DashScope rerank 模型，关闭用规则版
USE_LLM_RERANK=false
